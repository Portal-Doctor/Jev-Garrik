# mock | jev
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

# Dashboard. The Coinbase engine uses CB_PORT.
PORT=3000

# ---------------------------------------------------------------------------
# cb (Coinbase paper trading). Postgres persistence.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://cb:cb@localhost:5432/cb
CB_PAIRS=UNI-USD,NEAR-USD,BCH-USD,SUI-USD,AVAX-USD,ARB-USD
CB_DECIDE_SEC=300
# Position timer. Decide cadence stays CB_DECIDE_SEC. Outcomes are still scored at 1h, 4h, and 24h.
CB_HORIZON_SEC=86400
CB_NOTIONAL_USD=1000
CB_BANKROLL_USD=12000
CB_MAX_GROSS_USD=3000
# C3: still the public worst-case tier. The 10 bps intro tier is a backtest column, not this default.
CB_MAKER_FEE_BPS=50
CB_TAKER_FEE_BPS=90
CB_FILL_HAIRCUT=0.5
CB_ENTRY_TIMEOUT_SEC=120
CB_REPRICE_TICKS=2
CB_NEVER_CROSS_ENTRY=true
CB_BUY_THRESHOLD=0.70
CB_SELL_THRESHOLD=0.4
CB_FEE_BUFFER=1.5
CB_STOP_LOSS_BPS=150
CB_TAKE_PROFIT_BPS=250
CB_MAX_SLIPPAGE_BPS=10
CB_DEPTH_PARTICIPATION=0.25
CB_MIN_SIZE_USD=25
# Backtest comparison only. These do not change the live paper book.
CB_BREAKOUT_BARS=20
CB_TREND_EMA_BARS=50
CB_ATR_BARS=14
CB_TRAIL_ATR=3
CB_BREAKOUT_MAX_HOLD_SEC=1209600
CB_KILL=false
CB_DAILY_LOSS_USD=900
CB_PORT=3001
# MODEL is shared with the demo (mock | jev). For jev, pick ONE transport:
#   Vercel AI Gateway (no TypeSafe waitlist): set AI_GATEWAY_API_KEY; routes model typesafe-ai/jev.
#   Direct TypeSafe provider: set TYPESAFE_AI_API_KEY (console.typesafe.ai/settings/keys).
# AI_GATEWAY_API_KEY=
# JEV_GATEWAY_MODEL_ID=typesafe-ai/jev
# CDP key, only needed for the user channel / live trading (M5):
# COINBASE_API_KEY_NAME=
# COINBASE_API_PRIVATE_KEY=
