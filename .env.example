# Monad RPC for sends, receipts, nonce and the one-time gas estimate.
# Public endpoint works for dry runs; use a dedicated provider (Alchemy/QuickNode) for live trading.
RPC_URL=https://rpc.monad.xyz
# RPC for book reads, eth_blockNumber polling and Trade logs. The public endpoint is the fastest of these
# (~18 ms per read) and this stays under its 25 rps cap: 1 read + 1 getLogs per block + polling every 150 ms.
READ_RPC_URL=https://rpc.monad.xyz
# Optional WebSocket for newHeads. Polling backstop runs regardless.
WS_URL=wss://rpc.monad.xyz

# Leave PRIVATE_KEY unset (or DRY_RUN=true) to simulate: real book, real decisions, orders rest for one
# block and fill when a real print crosses their price.
# Generate a local EOA (writes PRIVATE_KEY, keeps DRY_RUN=true): bun run wallet:new
PRIVATE_KEY=
DRY_RUN=true

# Local Kuru engine is maker paper only. The tweet demo is not started here.
KURU_MODE=maker
KURU_REQUOTE_TICKS=2
KURU_FILL_HAIRCUT=0.5
KURU_DECIDE_BLOCKS=100
# Hard kill for live sends. Also trips if data/KILL exists, or daily P&L drops through the limit.
KURU_KILL=false
KURU_DAILY_LOSS_USD=15
KURU_GATE_MIN_FILLS=200
# Optional fee overrides (unset = live market contract). Probe with: bun run kuru:fees
# KURU_MAKER_FEE_BPS=
# KURU_TAKER_FEE_BPS=

# CCTP fallback (only if Coinbase has no native Monad USDC withdrawal). Source-chain RPC for the burn.
# SOURCE_RPC_URL=

# mock | jev
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

# Every block posts one post-only limit order of this size on the side the model picked, this many ticks
# inside the touch (0 joins the best bid/ask). Kuru MON-USDC minimum order is 200 MON; tick is 0.000001.
TRADE_SIZE_MON=200
QUOTE_INSIDE_TICKS=1
MAX_POSITION_MON=1000
BANKROLL_USD=100

# Kuru limit orders draw from the margin account, not the wallet. At startup the bot deposits enough to
# reach these balances. Asks need MON, bids need USDC. Proceeds of fills also land in margin.
MARGIN_MON=600
MARGIN_USDC=20
# MarginAccount for the MON-USDC market. Only change if MARKET changes.
MARGIN_ACCOUNT=0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5

# Monad charges gas on the LIMIT, so the limit is hardcoded and eth_estimateGas never runs in the loop.
# Unset: estimated once at startup (needs margin funds), else 350000. Expect ~0.03 MON per block live.
GAS_LIMIT=
# EIP-1559 type-2 only. Effective price = base fee + priority, so a high cap costs nothing.
# Monad's base fee floor is 100 gwei and eth_maxPriorityFeePerGas is hardcoded at 2 gwei.
MAX_FEE_GWEI=400
PRIORITY_FEE_GWEI=2

# Host tweet dashboard used 3000. Compose sets PORT=3002 for the Kuru container.
PORT=3000

# ---------------------------------------------------------------------------
# cb (Coinbase paper trading) - separate app in cb/, Postgres persistence.
# Start the database with `docker compose up -d`, then `bun run cb`.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://cb:cb@localhost:5432/cb
CB_PAIRS=SOL-USD,DOGE-USD,SUI-USD,XRP-USD,AVAX-USD
CB_DECIDE_SEC=300
CB_HORIZON_SEC=14400
CB_NOTIONAL_USD=1000
CB_BANKROLL_USD=10000
# C3: still the public worst-case tier. Set the real Advanced Trade rates before treating this
# 4h window as the official measurement, then restart cb only.
CB_MAKER_FEE_BPS=50
CB_TAKER_FEE_BPS=90
CB_FILL_HAIRCUT=0.5
CB_ENTRY_TIMEOUT_SEC=120
CB_REPRICE_TICKS=2
CB_NEVER_CROSS_ENTRY=true
CB_KILL=false
CB_DAILY_LOSS_USD=1500
CB_PORT=3001
# MODEL is shared with the demo (mock | jev). For jev, pick ONE transport:
#   Vercel AI Gateway (no TypeSafe waitlist): set AI_GATEWAY_API_KEY; routes model typesafe-ai/jev.
#   Direct TypeSafe provider: set TYPESAFE_AI_API_KEY (console.typesafe.ai/settings/keys).
# AI_GATEWAY_API_KEY=
# JEV_GATEWAY_MODEL_ID=typesafe-ai/jev
# CDP key, only needed for the user channel / live trading (M5):
# COINBASE_API_KEY_NAME=
# COINBASE_API_PRIVATE_KEY=
