{
  "name": "jev-trader",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "^3.0.0",
    "@kuru-labs/kuru-sdk": "^0.0.95",
    "ai": "^7.0.107",
    "ethers": "5"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "cb": "bun run cb/index.ts",
    "cb:dev": "bun --watch cb/index.ts",
    "cb:report": "bun run cb/report.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "ui:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ui-start.ps1",
    "ui:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ui-stop.ps1",
    "test": "bun test cb"
  }
}
