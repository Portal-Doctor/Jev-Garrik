{
  "name": "jev-trader",
  "module": "cb/index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "^3.0.0",
    "ai": "^7.0.107"
  },
  "scripts": {
    "cb": "bun run cb/index.ts",
    "cb:dev": "bun --watch cb/index.ts",
    "cb:report": "bun run cb/report.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "cb:deploy": "docker compose up -d --build cb",
    "cb:logs": "docker compose logs -f cb",
    "cb:restart": "docker compose restart cb",
    "engines:up": "docker compose up -d --build",
    "engines:down": "docker compose stop cb",
    "ui:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ui-start.ps1",
    "ui:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ui-stop.ps1",
    "test": "bun test cb"
  }
}
